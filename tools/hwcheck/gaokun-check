#!/usr/bin/env bash
# gaokun3 (MateBook E Go) 硬件自检
# 快速确认各移植补丁模块是否正常工作，用于 U 盘测试 / 安装后验收
# 用法: gaokun-check    (建议 sudo 运行以读取内核日志)
set -uo pipefail

PASS=0 WARN=0 FAIL=0
ok()   { printf '  [ OK ] %s\n' "$*"; PASS=$((PASS+1)); }
warn() { printf '  [WARN] %s\n' "$*"; WARN=$((WARN+1)); }
fail() { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL+1)); }
info() { printf '         %s\n' "$*"; }
hdr()  { printf '\n== %s ==\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# dmesg 普通用户可能被限制（dmesg_restrict），提前探测
DMESG_OK=1
dmesg 2>/dev/null | head -c 1 | grep -q . || DMESG_OK=0
kd()   { [[ $DMESG_OK -eq 1 ]] && dmesg "$@" 2>/dev/null; }
kdg()  { [[ $DMESG_OK -eq 1 ]] && dmesg 2>/dev/null | grep -i "$1"; }

echo "gaokun3 (MateBook E Go) 硬件自检  $(date '+%F %T')"

# ---------------------------------------------------------------- 内核
hdr "内核 / 设备树"
info "kernel: $(uname -r)"
model="$(cat /proc/device-tree/model 2>/dev/null | tr -d '\0')"
info "model: ${model:-unknown}"
if uname -r | grep -q 'gaokun3'; then
    ok "gaokun3 内核已加载"
else
    warn "当前内核非 gaokun3 定制版本"
fi

# ---------------------------------------------------------------- 触摸屏
hdr "触摸屏 (himax HX83121A)"
if grep -qi himax /proc/bus/input/devices; then
    ok "himax 输入设备已注册"
    # 中断活动: 间隔 1.5s 采样两次，增量>0 说明触摸事件正常上报
    irq_cnt() {
        grep -m1 -i himax /proc/interrupts | awk '{s=0; for(i=2;i<NF;i++) if($i ~ /^[0-9]+$/) s+=$i; print s+0}'
    }
    if c1=$(irq_cnt); then
        sleep 1.5
        c2=$(irq_cnt || echo "$c1")
        if [[ $((c2 - c1)) -gt 0 ]]; then
            ok "触摸中断活跃（1.5s 内 +$((c2 - c1)) 次事件）"
        else
            warn "触摸中断无活动（未触摸属正常；若触摸无响应请检查 dmesg）"
        fi
    fi
else
    fail "未发现 himax 输入设备（模块未加载或 probe 失败）"
fi
if kdg 'himax' | grep -qiE 'fail|broken|error|reinit failed'; then
    fail "himax 近期有错误日志:"
    kdg 'himax' | grep -iE 'fail|broken|error|reinit failed' | tail -n 4 | sed 's/^/         /'
else
    kdg 'Detected IC HX83121A' | tail -n 1 | sed 's/^/         /'
fi

# ---------------------------------------------------------------- EC / 电池
hdr "EC / 电池 (gaokun-ec)"
bat=""
for d in /sys/class/power_supply/*/; do
    [[ -f "${d}charge_control_start_threshold" ]] && bat="$d"
done
if [[ -n "$bat" ]]; then
    ok "EC 电池驱动就绪（charge thresholds 可用）"
    info "capacity: $(cat "$bat/capacity")%  status: $(cat "$bat/status")"
    info "charge thresholds: $(cat "$bat/charge_control_start_threshold")%-$(cat "$bat/charge_control_end_threshold")%"
else
    fail "未找到 EC 电池设备（/sys/class/power_supply 下无 charge_control_*）"
fi
if grep -qiE 'name:.*LID|LID' /proc/bus/input/devices; then
    ok "EC 盖板开关 (lid) 已注册"
else
    warn "未发现 lid 输入设备"
fi

# ---------------------------------------------------------------- 显示 / GPU
hdr "面板 / GPU (msm adreno)"
dsi_ok=0
for c in /sys/class/drm/card*-DSI-*/status; do
    [[ $(cat "$c" 2>/dev/null) == connected ]] && dsi_ok=1
done
if [[ $dsi_ok -eq 1 ]]; then
    ok "DSI 面板已连接"
else
    fail "DSI 面板未连接"
fi
bl=$(ls -d /sys/class/backlight/* 2>/dev/null | head -n1)
[[ -n "$bl" ]] && info "背光: $(cat "$bl/brightness")/$(cat "$bl/max_brightness")"
if [[ -e /dev/dri/renderD128 ]]; then
    ok "GPU render 节点存在 (/dev/dri/renderD128)"
else
    fail "GPU render 节点缺失"
fi
if kdg 'adreno' | grep -qiE 'fail|error|timeout'; then
    warn "adreno 近期有错误日志"
    kdg 'adreno' | grep -iE 'fail|error|timeout' | tail -n 3 | sed 's/^/         /'
fi

# ---------------------------------------------------------------- 视频硬解
hdr "视频硬解 (venus)"
nvideo=$(ls /dev/video[0-9]* 2>/dev/null | wc -l)
if [[ $nvideo -gt 0 ]]; then
    ok "venus 视频设备存在（/dev/video* x$nvideo）"
elif kdg 'venus' | grep -q .; then
    warn "venus 已加载但无 /dev/video* 设备"
else
    warn "未检测到 venus（模块未加载或无固件）"
fi
if kdg 'venus' | grep -qiE 'fail|error|timeout'; then
    warn "venus 近期有错误日志"
fi

# ---------------------------------------------------------------- 音频
hdr "音频 (audioreach / wcd938x)"
if have aplay; then
    if aplay -l 2>/dev/null | grep -q '^card'; then
        ok "声卡已注册"
        aplay -l 2>/dev/null | grep '^card' | head -n 3 | sed 's/^/         /'
    else
        fail "未发现声卡"
    fi
else
    warn "aplay 不可用（缺 alsa-utils），跳过声卡检测"
fi
if kdg 'audioreach' | grep -qiE 'fail|error|timeout'; then
    warn "audioreach 近期有错误日志"
    kdg 'audioreach' | grep -iE 'fail|error|timeout' | tail -n 3 | sed 's/^/         /'
fi

# ---------------------------------------------------------------- 网络
hdr "WiFi (ath11k) / 蓝牙"
wlan=$(ls -d /sys/class/net/wlan* 2>/dev/null | head -n1)
if [[ -n "$wlan" ]]; then
    ok "wlan 接口存在（$(basename "$wlan"), $(cat "$wlan/operstate")）"
else
    fail "未发现 wlan 接口（ath11k 未就绪）"
fi
if kdg 'ath11k' | grep -qiE 'fail|error|timeout'; then
    warn "ath11k 近期有错误日志"
    kdg 'ath11k' | grep -iE 'fail|error|timeout' | tail -n 3 | sed 's/^/         /'
fi
if [[ -d /sys/class/bluetooth/hci0 ]]; then
    ok "hci0 蓝牙适配器存在"
    if systemctl is-active --quiet bluetooth 2>/dev/null; then
        info "bluetoothd: active"
    else
        warn "bluetoothd 未运行"
    fi
else
    warn "未发现 hci0（btwqcn 蓝牙未就绪）"
fi

# ---------------------------------------------------------------- swap / 存储
hdr "zram / 根文件系统"
if grep -q zram /proc/swaps 2>/dev/null; then
    ok "zram swap 已启用"
    grep zram /proc/swaps | awk '{printf "         %s %s\n", $1, $3*1024/1048576 " MB"}' 2>/dev/null | head -n1
else
    warn "zram swap 未启用（zram-generator 未运行？）"
fi
info "root: $(findmnt -n -o SOURCE /) ($(findmnt -n -o FSTYPE /))"
df -h / | tail -n1 | awk '{printf "         使用: %s / %s (%s)\n", $3, $2, $5}'

# ---------------------------------------------------------------- 汇总
hdr "最近的内核错误/警告 (最多 8 条)"
if [[ $DMESG_OK -eq 1 ]]; then
    errout=$(dmesg -l err,warn 2>/dev/null | tail -n 8)
    if [[ -n "$errout" ]]; then
        printf '%s\n' "$errout" | sed 's/^/         /'
    else
        info "（无）"
    fi
else
    info "内核日志不可读（dmesg_restrict），请 sudo 运行查看"
fi

printf '\n== 结果: %d OK, %d WARN, %d FAIL ==\n' "$PASS" "$WARN" "$FAIL"
[[ $FAIL -eq 0 ]]
